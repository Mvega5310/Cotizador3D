// Esquema de datos — Cotizador 3D para ejecutores
// Ver docs/MODELO-DE-DATOS.md para el razonamiento detrás de cada tabla.
// PostgreSQL en todos los entornos (local y producción). DATABASE_URL apunta
// a la base que corresponda; ver apps/web/README.md.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  prueba
  personal
  profesional
  empresa
}

// Unidades de cotización (guía v3, sección 03).
enum Unidad {
  kg
  m2
  m3
  ml
  und
}

enum EstadoProyecto {
  procesando // la IA está leyendo los planos, en segundo plano (lib/generacion.ts)
  error      // la generación falló; se puede reintentar con los planos guardados
  borrador
  en_revision
  generado
  entregado
}

enum OrigenParametro {
  ia
  usuario
}

enum TipoToken {
  verificacion
  recuperacion
}

model Cuenta {
  id          String    @id @default(cuid())
  nombre      String
  plan        Plan      @default(prueba)
  pruebaHasta DateTime?
  cupoMes     Int // proyectos que puede generar este mes, según el plan
  esEmpresa   Boolean   @default(false) // persona (false) o empresa/equipo (true)
  creadoEn    DateTime  @default(now())

  usuarios    Usuario[]
  proyectos   Proyecto[]
  plantillas  PlantillaCotizacion[]
}

model Usuario {
  id               String   @id @default(cuid())
  email            String   @unique
  nombre           String
  passwordHash     String
  emailVerificado  Boolean  @default(false)
  cuentaId         String
  cuenta           Cuenta   @relation(fields: [cuentaId], references: [id])
  creadoEn         DateTime @default(now())

  proyectos Proyecto[]
  tokens    TokenAuth[]
}

// Enlaces de un solo uso para verificar correo o recuperar contraseña — un
// mismo mecanismo para los dos (lib/actions/auth.ts). `token` se genera con
// crypto.randomBytes; de un solo uso (usadoEn) y con vencimiento (expiraEn).
model TokenAuth {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  tipo      TipoToken
  token     String    @unique
  expiraEn  DateTime
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())
}

model Proyecto {
  id          String         @id @default(cuid())
  cuentaId    String
  cuenta      Cuenta         @relation(fields: [cuentaId], references: [id])
  creadoPorId String
  creadoPor   Usuario        @relation(fields: [creadoPorId], references: [id])
  cliente     String // nombre del cliente final, para el PDF
  tipoObra    String // tipo de producto, texto abierto (no enum): 'cubierta_cercha', 'cocina_integral', 'porton_reja', ...
  estado      EstadoProyecto @default(borrador)
  // Supuestos y advertencias que la IA dejó al leer los planos, y cuántos
  // elementos suyos no se pudieron interpretar. Se muestran siempre en la
  // página del proyecto (antes viajaban en la URL y se perdían al recargar).
  notasIA       String?
  descartadosIA Int            @default(0)
  errorIA       String? // por qué falló la última generación (estado = error)
  iniciadoIA    DateTime? // cuándo arrancó la última generación, para detectar las que se cortaron
  // Precios y parámetros de la cotización (lib/cotizacion.ts): por proyecto y
  // no por versión — corregir una medida no debe borrar los precios.
  cotizacion    Json?
  creadoEn    DateTime       @default(now())

  archivos ArchivoEntrada[]
  versiones VersionProyecto[]
  generaciones GeneracionIA[]
}

// Una llamada a la IA (lib/generacion.ts): tokens y costo, para saber cuánto
// cuesta de verdad cada proyecto y cada cuenta. Se registra también cuando
// falla: una respuesta que no se pudo leer igual gastó tokens.
model GeneracionIA {
  id            String   @id @default(cuid())
  proyectoId    String
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id])
  cuentaId      String
  modelo        String
  inputTokens   Int      @default(0) // sin caché
  outputTokens  Int      @default(0)
  cacheLectura  Int      @default(0)
  cacheEscritura Int     @default(0)
  costoUsd      Float    @default(0) // calculado con lib/costos.ts al momento de la llamada
  duracionMs    Int
  exito         Boolean
  error         String?
  creadoEn      DateTime @default(now())

  @@index([cuentaId, creadoEn])
  @@index([creadoEn])
}

model ArchivoEntrada {
  id           String   @id @default(cuid())
  proyectoId   String
  proyecto     Proyecto @relation(fields: [proyectoId], references: [id])
  tipo         String // 'plano' | 'boceto' | 'foto' | 'descripcion'
  url          String? // null cuando tipo = 'descripcion'
  descripcion  String? // texto libre del usuario
  subidoEn     DateTime @default(now())
}

model VersionProyecto {
  id         String   @id @default(cuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  numero     Int // 1, 2, 3... incremental dentro del proyecto
  creadoEn   DateTime @default(now())

  parametros Parametro[] // entradas crudas (transitorio: solo las usa el kit de cubierta)
  etapas     Etapa[]
  elementos  Elemento[]
  resultado  Resultado?

  @@unique([proyectoId, numero])
}

// Etapa de obra dentro de una versión (p. ej. "Estructura de cubierta", "Pérgola y cochera").
model Etapa {
  id        String          @id @default(cuid())
  versionId String
  version   VersionProyecto @relation(fields: [versionId], references: [id])
  numero    Int
  nombre    String

  elementos Elemento[]

  @@unique([versionId, numero])
}

// Un elemento del proyecto: qué es, su forma, su pieza del catálogo, cuánto hay,
// en qué unidad, a qué etapa pertenece y de dónde salió el dato (IA o usuario).
// El motor arma el 3D y el cuadro de cantidades a partir de estas filas.
model Elemento {
  id        String          @id @default(cuid())
  versionId String
  version   VersionProyecto @relation(fields: [versionId], references: [id])
  etapaId   String?
  etapa     Etapa?          @relation(fields: [etapaId], references: [id])
  nombre    String // 'Cercha principal'
  forma     String // tipo de forma que el motor sabe dibujar: 'viga', 'panel', 'volumen', 'pieza', ...
  geometria Json // medidas y posición de la forma; su esquema depende de `forma`
  piezaId   String?
  pieza     CatalogoPieza?  @relation(fields: [piezaId], references: [id])
  cantidad  Float // en `unidad`
  unidad    Unidad
  origen    OrigenParametro
  confirmado Boolean        @default(false) // false = referencia pendiente de confirmar
}

model Parametro {
  id         String          @id @default(cuid())
  versionId  String
  version    VersionProyecto @relation(fields: [versionId], references: [id])
  clave      String // p.ej. 'ridgeZ', 'houseL', 'perfil_cercha'
  valor      String // guardado como texto; se tipa/parsea en la capa de aplicación
  unidad     String? // 'm', 'kg/m', null para valores no numéricos
  origen     OrigenParametro
  perfilId   String?
  perfil     CatalogoPieza?  @relation(fields: [perfilId], references: [id])
}

// Catálogo de piezas compartido entre proyectos (guía v3, sección 09).
// Una pieza que falta se agrega una vez y queda disponible para todos.
model CatalogoPieza {
  id           String   @id @default(cuid())
  cuentaId     String? // null = catálogo global del sistema
  tipo         String // 'perfil_acero', 'teja', 'lamina', 'vidrio', 'tablero', 'puerta', ...
  nombre       String // 'Tubo rect. 150×50×4 mm'
  unidad       Unidad // unidad en la que se cotiza
  dimensiones  Json // ancho, alto, espesor, etc.; depende de `tipo`
  factor       Float? // kg por unidad o rendimiento, cuando aplica (p. ej. kg/m de un perfil)
  // Reglas de consumo derivado: [{ nombre, unidad, base, factor, entero? }]
  // (pintura por superficie, soldadura por kg...). Ver engine/interprete.js.
  consumos     Json?
  reutilizable Boolean  @default(true)

  parametros Parametro[]
  elementos  Elemento[]
}

model Resultado {
  id            String          @id @default(cuid())
  versionId     String          @unique
  version       VersionProyecto @relation(fields: [versionId], references: [id])
  renders       Json // [{ nombre, url }]
  pdfUrl        String?
  linkCompleto  String? // token/URL del visor completo (para el usuario)
  linkCliente   String? // token/URL del visor solo-vistas (para compartir)
  marcaAgua     Boolean         @default(true) // true durante la prueba
  bom           Json // mismo shape que casa-castaneda/data/bom.json
  generadoEn    DateTime        @default(now())
}

model PlantillaCotizacion {
  id           String   @id @default(cuid())
  cuentaId     String
  cuenta       Cuenta   @relation(fields: [cuentaId], references: [id])
  nombre       String
  archivoUrl   String // el formato original subido por el usuario
  mapeoColumnas Json // { columnaOrigen: campoBom }
  creadoEn     DateTime @default(now())
}
